def add_book():
    print("  # Add Book # ")
    book_title = input("Enter book Title : ")
    book_writer= input("Enter The Authour Name :")
    try:
        book_id    = int(input("Enter book ID: "))
    except ValueError:
        print("ID MUST BE A NUMBER!.")
        return
    file = open("books.txt","a")
    file.write(f"{book_title},{book_writer},{book_id}\n")
    file.close()
    print(" loading to save .......")
    time.sleep(2)
    print("Book added successfully!")
def view_books():
    print("  # View Books # ")
    try:
        file = open("books.txt","r")
        data = file.read()
        if data == "":
            print("No books found.")
        else:
            print(data)
          
    except FileNotFoundError:
        print("No books found. ")

